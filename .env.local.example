# Template de variables de entorno para pontuladrillotp.
# Copiar este archivo a .env.local y rellenar con valores reales.
# .env.local está en .gitignore → no se commitea ni se pushea a GitHub.

# ── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_KEY=<your-publishable-key>

# ── Payku (pasarela de pago) ───────────────────────────────────────────────
# Sandbox / Test (para desarrollo local). NO usar las de PROD acá.
VITE_PAYKU_PUBLIC_TOKEN=tkpu_test_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_PAYKU_API_URL=https://des.payku.cl/api

# La secret key NO debe estar en el front (sin prefijo VITE_).
# Se usa solo en endpoints backend (cuando se implemente webhook /
# verificación de transacciones server-to-server).
PAYKU_SECRET_KEY=skpu_test_xxxxxxxxxxxxxxxxxxxxxxxx
